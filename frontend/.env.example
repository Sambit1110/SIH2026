# URL of the Trace-X FastAPI backend.
#
# Local development: the backend dev server (uvicorn).
# Production (Vercel): the URL of the separately-deployed backend Vercel
# project, e.g. https://trace-x-backend.vercel.app -- set this as an
# Environment Variable on the FRONTEND Vercel project (Vercel dashboard ->
# Project -> Settings -> Environment Variables), not in this file. This is
# the only environment variable the frontend needs; it is safe to expose to
# the browser (NEXT_PUBLIC_) since it's just a base URL, not a credential.
NEXT_PUBLIC_API_URL=http://localhost:8000
