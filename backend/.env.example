# --- Trace-X backend configuration ---
# Copy to .env and adjust as needed. Every value below is optional for LOCAL
# development -- the platform runs fully in Demo Mode with zero
# configuration, using SQLite and the local filesystem. In PRODUCTION
# (Vercel), DATABASE_URL, SUPABASE_URL, and SUPABASE_SERVICE_ROLE_KEY are
# required -- see DEPLOYMENT.md.

# --- Database ---
# Local dev default: SQLite, zero setup.
# Production: a Supabase Postgres connection string. Use the "Transaction"
# pooler connection string from Supabase (Project Settings -> Database ->
# Connection string -> Transaction pooler, typically port 6543) -- it's the
# form recommended for serverless/short-lived connections like Vercel
# functions. Append ?sslmode=require if it isn't already present.
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./trace_x.db

# --- Intelligence mode ---
# "demo" (default): all IP/domain intelligence comes from a deterministic,
#   versioned local dataset. Zero external network calls, zero API keys.
# "live": every newly observed IP/domain (e.g. from a real uploaded .eml) is
#   looked up for real -- IP geolocation + hosting/ASN via ip-api.com,
#   domain registration via RDAP (rdap.org), and DNS MX/SPF via direct DNS
#   queries. All three are free and require no API key. Any lookup that
#   genuinely fails or times out falls back to demo data automatically, and
#   the UI always shows which one actually happened via each record's
#   "source" field. There is no live reputation/blacklist check wired up --
#   reputation stays "Unknown" for real/live results. Recommended for
#   production; set on the BACKEND Vercel project's environment variables.
INTEL_MODE=demo

# --- Supabase (required in production; leave unset for local SQLite dev) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Public/browser key -- accepted for documentation completeness. This
# backend never uses it for privileged operations; it exists only in case a
# future feature calls Supabase's client-safe REST API directly.
SUPABASE_ANON_KEY=
# SERVER-SIDE SECRET. Grants full access, bypassing Row Level Security and
# Storage policies. Set this only as a server-side environment variable
# (Vercel Environment Variables on the BACKEND project) -- never prefix it
# with NEXT_PUBLIC_, never reference it from any frontend code, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name for evidence (.eml) files. Must be private (not
# public) -- see supabase/migrations/20260910000001_storage_bucket.sql.
SUPABASE_STORAGE_BUCKET=evidence

# --- CORS ---
# Comma-separated list of additional allowed frontend origins, appended to
# the built-in localhost:3000/3001 defaults. Set this to your deployed
# frontend's Vercel URL(s) in production, e.g.:
#   CORS_ORIGINS_EXTRA=https://trace-x-frontend.vercel.app
CORS_ORIGINS_EXTRA=
